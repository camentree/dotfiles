{
  "env": {
    "DIRHELPER_USER_DIR_SUFFIX": "",
    "CLAUDE_AFK_TIMEOUT_MS": "2000000000"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git rebase origin/master)",
      "Bash(git rebase --continue)",
      "Bash(git push --force-with-lease *)",
      "Bash(pbcopy)",
      "Bash(pbcopy *)",
      "Bash(git rm *)",
      "Bash(git commit *)",
      "Bash(git rebase --onto *)",
      "Bash(git checkout * -- *)",
      "Bash(curl -s -X GET http://localhost:*)",
      "Bash(curl -s -X POST http://localhost:*)",
      "Bash(curl -N -s http://localhost:*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME*)",
      "Bash(sudo rm *)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(chmod -R 777 *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Bash(op read *)",
      "Bash(op item get *)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/",
      "/tmp"
    ]
  },
  "skillOverrides": {
    "dataviz": "name-only",
    "claude-api": "name-only",
    "artifact-design": "name-only",
    "artifact-diagramming": "name-only",
    "artifact-capabilities": "name-only",
    "schedule": "user-invocable-only",
    "update-config": "user-invocable-only",
    "init": "off",
    "keybindings-help": "off",
    "fewer-permission-prompts": "off",
    "security-review": "off",
    "run": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/update-tab-status.sh clear"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/update-tab-status.sh working"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/update-tab-status.sh working"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/update-tab-status.sh blocked"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/update-tab-status.sh blocked"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "elicitation_dialog|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/update-tab-status.sh blocked"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/update-tab-status.sh done"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/update-tab-status.sh done"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/update-tab-status.sh clear"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/status-line.sh"
  },
  "enabledPlugins": {
    "cowork-plugin-management@synced": false
  },
  "extraKnownMarketplaces": {},
  "outputStyle": "Concise",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "medium"
    }
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "never",
  "dialogExpiry": "never",
  "tui": "fullscreen",
  "autoDreamEnabled": true,
  "theme": "dark-daltonized",
  "editorMode": "normal",
  "autoCompactEnabled": false,
  "fileCheckpointingEnabled": true,
  "remoteControlAtStartup": true,
  "crossSessionInbound": "accept",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "useAutoModeDuringPlan": true
}
