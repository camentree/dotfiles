{
  "env": {
    "DIRHELPER_USER_DIR_SUFFIX": "",
    "CLAUDE_AFK_TIMEOUT_MS": "2000000000"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(git branch *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git stash *)",
      "Bash(git status *)",
      "Bash(cat *)",
      "Bash(sysctl *)",
      "Bash(lsof *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(sed -n *)",
      "Bash(awk *)",
      "Bash(jq *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(tr *)",
      "Bash(du *)",
      "Bash(date *)",
      "Bash(printf *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(gh api *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(git worktree list *)",
      "Bash(git blame *)",
      "Bash(git rev-parse *)",
      "Bash(docker ps *)",
      "Bash(aws logs get-query-results *)",
      "Bash(sbt *)",
      "Bash(which *)",
      "Bash(pwd)",
      "Bash(echo *)",
      "Bash(env *)",
      "Bash(defaults *)",
      "Bash(mdfind *)",
      "Bash(npm run compile *)",
      "Bash(curl -X GET *)",
      "Bash(pbcopy)",
      "WebSearch",
      "WebFetch",
      "Read",
      "Bash(mise where:*)",
      "Bash(npx difit *)",
      "Bash(bash ~/.claude/scripts/writing-audit-log.sh *)",
      "Skill(keybindings-help)",
      "mcp__linear__list_issues",
      "mcp__linear__get_issue",
      "mcp__linear__list_comments",
      "mcp__notion__notion-fetch",
      "mcp__notion__notion-search",
      "mcp__chrome-devtools__list_pages"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME*)",
      "Bash(sudo rm *)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(chmod -R 777 *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Bash(op read *)",
      "Bash(op item get *)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/",
      "/tmp"
    ]
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/update-tab-status.sh idle"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/update-tab-status.sh working"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/writing-gate.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/update-tab-status.sh idle"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/update-tab-status.sh bell"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/update-tab-status.sh idle"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/update-tab-status.sh bell"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/update-tab-status.sh clear"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "elicitation_dialog|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/update-tab-status.sh bell"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/writing-audit-log.sh"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/update-tab-status.sh bell"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/update-tab-status.sh bell"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/format-on-edit.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/writing-gate.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/comment-check.sh"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/writing-gate.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/update-tab-status.sh working"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/statusline-command.sh"
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "august-marketplace": {
      "source": {
        "source": "github",
        "repo": "augusthealth/august-marketplace"
      }
    }
  },
  "outputStyle": "writing-for-humans",
  "effortLevel": "high",
  "promptSuggestionEnabled": false,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "autoDreamEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
