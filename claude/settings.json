{
  "env": {
    "DIRHELPER_USER_DIR_SUFFIX": "",
    "CLAUDE_AFK_TIMEOUT_MS": "2000000000"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME*)",
      "Bash(sudo rm *)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(chmod -R 777 *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Bash(op read *)",
      "Bash(op item get *)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": ["~/", "/tmp"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/autonomous-guard.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/status-line.sh"
  },
  "outputStyle": "Concise",
  "effortLevel": "medium",
  "worktree": { "baseRef": "fresh" },
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "august-marketplace": {
      "source": {
        "source": "github",
        "repo": "augusthealth/august-marketplace"
      }
    }
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "never",
  "dialogExpiry": "never",
  "tui": "fullscreen",
  "autoDreamEnabled": true,
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true,
  "theme": "dark-daltonized",
  "editorMode": "normal",
  "fileCheckpointingEnabled": true,
  "remoteControlAtStartup": true,
  "crossSessionInbound": "accept",
  "useAutoModeDuringPlan": true
}
