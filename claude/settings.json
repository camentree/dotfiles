{
  "env": {
    "DIRHELPER_USER_DIR_SUFFIX": "",
    "CLAUDE_AFK_TIMEOUT_MS": "2000000000"
  },
  "includeCoAuthoredBy": false,
  "skillOverrides": {
    "dataviz": "name-only",
    "claude-api": "name-only",
    "artifact-design": "name-only",
    "artifact-diagramming": "name-only",
    "artifact-capabilities": "name-only",
    "schedule": "user-invocable-only",
    "code-review": "user-invocable-only",
    "simplify": "user-invocable-only",
    "loop": "user-invocable-only",
    "update-config": "user-invocable-only",
    "claude-in-chrome": "user-invocable-only",
    "init": "off",
    "keybindings-help": "off",
    "fewer-permission-prompts": "off",
    "security-review": "off",
    "run": "off"
  },
  "permissions": {
    "allow": [
      "Bash(git rebase origin/master)",
      "Bash(git rebase --continue)",
      "Bash(gh stack push)",
      "Bash(gh stack sync)",
      "Bash(git push --force-with-lease *)",
      "Bash(pbcopy)",
      "Bash(pbcopy *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME*)",
      "Bash(sudo rm *)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(chmod -R 777 *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Bash(op read *)",
      "Bash(op item get *)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/",
      "/tmp"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/autonomous-task-guard.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/status-line.sh"
  },
  "enabledPlugins": {
    "august-metals@skills-dir": false,
    "cowork-plugin-management@synced": false
  },
  "extraKnownMarketplaces": {},
  "outputStyle": "Concise",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "never",
  "dialogExpiry": "never",
  "tui": "fullscreen",
  "autoDreamEnabled": true,
  "theme": "dark-daltonized",
  "editorMode": "normal",
  "fileCheckpointingEnabled": true,
  "remoteControlAtStartup": true,
  "crossSessionInbound": "accept",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "useAutoModeDuringPlan": true
}
