      "findings": [
        { "title": "Typed rate is lost when the assessment is redone", "detail": "Enter 4,200, redo the assessment, the field is empty.", "reproduced": true },
        { "title": "No test for a rate of zero", "detail": "Zero is saved as \"no rate\". Read from the code.", "reproduced": false },
        { "title": "Migration has no default", "detail": "Existing agreements get null, which the PDF prints as blank.", "reproduced": false }
      ],
