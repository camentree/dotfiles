      "question": {
        "text": "Should the email log record emails sent to staff, or only to families?",
        "explanation": "When a community shares a task with a family member, we send an email. The new table records each of those emails so a community can prove how many times a family was asked to sign. Staff sometimes get the same emails.",
        "why": "It turns on what Naomi meant by \"prove how many times a family was asked\". That is about the feature, and changing it later needs a migration that can't recover past sends.",
        "options": [
          { "label": "Families only", "cost": "Can't be added back for past sends." },
          { "label": "Everyone, with a staff flag", "cost": "One extra column; reports filter it." }
        ],
        "pictures": ["fixture/share-dialog.svg", "fixture/contact-card.svg"],
        "asked": "2026-11-19T15:00:00-08:00",
        "answer": null
      },
