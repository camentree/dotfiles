#!/usr/bin/env bash

set -eo pipefail

usage() {
  cat <<EOF
Usage:
  august-app start|wait|status|stop [--worktree=<path>] [--user=<email>] [--api] [--dev] [--tunnel] [--lan]

start   Runs the valinor worktree's bin-local/dev, which starts its backend and
        its frontend, and stays in the foreground holding them: run it as a
        background shell. Sets AWS_PROFILE=us-developer when backend/.env has
        none, puts the system yarn first on PATH, and starts nothing while the
        shared Postgres holds 185 connections or more.
wait    Waits up to nine minutes for both to answer, then prints what status
        prints. Exits 1 when start failed, 2 when still starting.
status  Prints the URLs, the user, a bearer token for the backend, and the stop
        command.
stop    Stops this worktree's backend and frontend, nothing else.

The worktree is the valinor checkout that holds --worktree, or the one you are
in. Ports and the database name are read from its .env.local, which
bin-local/dev writes on the first start: edit that file to change one. --api,
--dev, --tunnel and --lan go to bin-local/dev as they are; with --api, wait
and status cover the external API too. Without --user, the user is
AUGUST_DEFAULT_USER, the one a fresh frontend tab signs in as.
EOF
}

verb="${1:-}"
[ $# -gt 0 ] && shift
worktree="$PWD"
user_given=""
api=false
dev_options=()
for argument in "$@"; do
  case "$argument" in
    --worktree=*) worktree="${argument#--worktree=}" ;;
    --api) api=true; dev_options+=("$argument") ;;
    --dev|--tunnel|--lan) dev_options+=("$argument") ;;
    --user=*) user_given="${argument#--user=}" ;;
    *) usage >&2; exit 1 ;;
  esac
done
case "$verb" in
  start|wait|status|stop) ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 1 ;;
esac

worktree="$(cd "$(git -C "$worktree" rev-parse --show-toplevel)" && pwd -P)"
backend="$worktree/backend"
frontend="$worktree/frontend"
[ -x "$worktree/bin-local/dev" ] || { echo "No bin-local/dev in $worktree: not a valinor worktree, or wk has not linked bin-local into it" >&2; exit 1; }

user="${user_given:-${AUGUST_DEFAULT_USER:-}}"
branch="$(git -C "$worktree" rev-parse --abbrev-ref HEAD)"

temporary_directory="${TMPDIR:-/tmp}"
state_directory="${temporary_directory%/}/august-app/$(printf '%s' "$branch" | tr '/' '-')"
mkdir -p "$state_directory"

env_value() { sed -n "s/^$1=//p" "$worktree/.env.local" 2>/dev/null | tail -1 || true; }

pings() {
  local port
  port="$(env_value "$1")"
  [ -n "$port" ] && curl -sf -o /dev/null -m 5 -X GET "http://localhost:$port/ping"
}

backend_answers() { pings PLAY_HTTP_PORT; }

api_answers() { pings INTEGRATIONS_API_PLAY_HTTP_PORT; }

frontend_answers() {
  local port
  port="$(env_value FRONTEND_PORT)"
  [ -n "$port" ] && curl -s -o /dev/null -m 5 -X GET "http://127.0.0.1:$port/"
}

everything_answers() { backend_answers && frontend_answers && { [ "$api" = false ] || api_answers; }; }

base64url() { base64 | tr '+/' '-_' | tr -d '=\n'; }

mint_token() {
  local username_uuid="$1" now header payload signature
  now=$(date +%s)
  header="$(printf '%s' '{"kid":"my_test_key","typ":"JWT","alg":"HS256"}' | base64url)"
  payload="$(printf '{"iat":%s,"exp":%s,"cognito:username":"%s"}' "$now" "$((now + 28800))" "$username_uuid" | base64url)"
  signature="$(printf '%s' "$header.$payload" | openssl dgst -sha256 -hmac testKey -binary | base64url)"
  echo "$header.$payload.$signature"
}

print_status() {
  local backend_port frontend_port database username_uuid="" query_string=""
  backend_port="$(env_value PLAY_HTTP_PORT)"
  frontend_port="$(env_value FRONTEND_PORT)"
  database="$(env_value DB_NAME)"
  [ -n "$database" ] && [ -n "$user" ] && username_uuid="$(docker exec db psql -U postgres -d "$database" -Atc "select username from user_account where email = '$user' and is_active" 2>/dev/null | head -1)"
  [ -n "$user_given" ] && [ -n "$username_uuid" ] && query_string="?mock_user=$username_uuid"
  if backend_answers; then
    echo "backend   http://localhost:$backend_port  answers  ($branch, database $database)"
  else
    echo "backend   http://localhost:${backend_port:-?}  down  ($backend)"
  fi
  if api_answers; then
    echo "api       http://localhost:$(env_value INTEGRATIONS_API_PLAY_HTTP_PORT)  answers"
  fi
  if frontend_answers; then
    echo "frontend  http://127.0.0.1:$frontend_port/$query_string  answers  ($branch)"
  else
    echo "frontend  http://127.0.0.1:${frontend_port:-?}  down  ($frontend)"
  fi
  if [ -n "$username_uuid" ]; then
    echo "user      $user ($username_uuid)"
    echo "token     Authorization: Bearer $(mint_token "$username_uuid")"
  else
    echo "user      no active $user in ${database:-the backend database}"
  fi
  echo "community Oak River Villas, org 30 facility 135"
  echo "logs      $state_directory/dev.log, $backend/loquat/logs/dev-backend.log"
  echo "stop      bash ~/Projects/dotfiles/claude/scripts/august-app stop --worktree=$worktree"
}

fail() {
  {
    echo "failed: $1"
    [ -n "$2" ] && [ -f "$2" ] && tail -30 "$2"
  } | tee "$state_directory/failed"
  exit 1
}

case "$verb" in
  status)
    print_status
    ;;
  wait)
    waited=0
    until everything_answers; do
      [ -f "$state_directory/failed" ] && { cat "$state_directory/failed"; exit 1; }
      [ "$waited" -ge 540 ] && { echo "still starting after $waited seconds: run wait again"; exit 2; }
      sleep 5
      waited=$((waited + 5))
    done
    print_status
    ;;
  stop)
    (cd "$worktree" && bin-local/dev stop)
    ;;
  start)
    rm -f "$state_directory/failed"
    if everything_answers; then
      echo "ready"
      print_status
      exit 0
    fi
    log="$state_directory/dev.log"
    if ! backend_answers; then
      connections="$(docker exec db psql -U postgres -Atc "select count(*) from pg_stat_activity")"
      [ "$connections" -lt 185 ] || fail "the shared Postgres holds $connections of 200 connections; stop none of anyone else's servers to make room"
    fi
    (
      cd "$worktree"
      grep -q '^AWS_PROFILE=' backend/.env 2>/dev/null || export AWS_PROFILE=us-developer
      export PATH="/run/current-system/sw/bin:$PATH"
      [ -n "$user" ] && dev_options+=(--user="$user")
      exec bin-local/dev "${dev_options[@]}"
    ) > "$log" 2>&1 < /dev/null &
    dev_pid=$!
    echo "starting the backend and the frontend, log $log"
    waited=0
    until everything_answers; do
      kill -0 "$dev_pid" 2>/dev/null || fail "bin-local/dev exited before both answered" "$log"
      [ "$waited" -ge 1800 ] && fail "no answer after $waited seconds" "$log"
      sleep 5
      waited=$((waited + 5))
    done
    echo "ready"
    print_status
    wait "$dev_pid"
    ;;
esac
