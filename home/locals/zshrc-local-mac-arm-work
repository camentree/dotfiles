export NOTEBOOK_PATH="$HOME/Documents/notes/Notebook.md"
export TODO_PATH="$HOME/Documents/notes/ToDo.md"
export AUGUST_VALINOR_PATH="$HOME/Projects/valinor"
export AUGUST_BACKEND_PATH="$AUGUST_VALINOR_PATH/backend"
export AUGUST_FRONTEND_PATH="$AUGUST_VALINOR_PATH/frontend"
export AUGUST_TOOLS_PATH="$HOME/Projects/Experimental-Tools"
export AUGUST_AI_COMPLETIONS_PATH="$HOME/Projects/ai-completions"
# One sbt server per worktree, each holding up to 5G of heap forever once a compile has grown it.
# G1's periodic GC (JDK 12+) runs a collection after 60s idle and hands freed heap back to macOS,
# so parked servers shrink to a few hundred MB while staying warm for incremental compiles.
export SBT_OPTS="-Xmx5G -XX:+UseG1GC -XX:G1PeriodicGCInterval=60000 -XX:MaxHeapFreeRatio=10 -XX:MinHeapFreeRatio=5"
[[ -n "$AUGUST_DEFAULT_USER" ]] || print -u2 "AUGUST_DEFAULT_USER unset — set it in ~/.zshenv.local"

alias valinor="cd $AUGUST_VALINOR_PATH"
alias backend="cd $AUGUST_BACKEND_PATH/loquat"
alias frontend="cd $AUGUST_FRONTEND_PATH"
alias notes="cd $HOME/Documents/notes && tabname notes && nvim ToDo.md"


function demo-data-token () {
  local -a staging
  zparseopts -D -E -- -staging=staging
  local user="${1:-$AUGUST_DEFAULT_USER}"
  local cognito
  [ -n "$staging" ] && cognito=-c

  export DEMO_DATA_TOKEN=$(
    cd "$AUGUST_BACKEND_PATH/demo-data" && ./bin/python test_token.py $cognito -e "$user" | tail -1
  )
  echo "$DEMO_DATA_TOKEN"
}

function backend-warm () {
  (
    cd "$AUGUST_BACKEND_PATH/loquat" || exit 1
    wk master > /dev/null || exit 1
    git fetch --prune && git pull --ff-only || exit 1
    sbt --client compile
    sbt --client shutdown
  )
}

functions -c wk-rm wk-rm-shared

function wk-rm () {
  local branch="${1:-$(git rev-parse --abbrev-ref HEAD 2>/dev/null)}"
  local repo_root=$(wk-repo-root)
  local branch_worktree=$(wk-existing-path "$branch")
  if [ "$repo_root" = "$AUGUST_VALINOR_PATH" ] && [ -n "$branch_worktree" ] && [ "$branch_worktree" != "$repo_root" ]; then
    (cd "$branch_worktree" && bin-local/dev rm)
  fi
  wk-rm-shared "$branch"
}
