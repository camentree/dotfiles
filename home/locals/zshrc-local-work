export NOTEBOOK_PATH="$HOME/Documents/notes/Notebook.md"
export TODO_PATH="$HOME/Documents/notes/ToDo.md"
export AUGUST_FULLSTACK_PATH="$HOME/Projects/august-fullstack"
export AUGUST_BACKEND_PATH="$AUGUST_FULLSTACK_PATH/august-backend"
export AUGUST_FRONTEND_PATH="$AUGUST_FULLSTACK_PATH/august-frontend"
export AUGUST_TOOLS_PATH="$HOME/Projects/Experimental-Tools"
export AUGUST_AI_COMPLETIONS_PATH="$HOME/Projects/ai-completions"
[[ -n "$AUGUST_DEFAULT_USER" ]] || print -u2 "AUGUST_DEFAULT_USER unset — set it in ~/.zshenv.local"

alias fullstack="cd $AUGUST_FULLSTACK_PATH"
alias backend="cd $AUGUST_BACKEND_PATH/loquat"
alias frontend="cd $AUGUST_FRONTEND_PATH"
alias dotfiles="cd $HOME/Projects/dotfiles && tabname dotfiles && nvim"

function _august-attach () {
  if [ -n "$TMUX" ]; then tmux switch-client -t "$1"
  else tmux attach -t "$1"; fi
}

function _august-branch () {
  local option="$1" fallback="$2"
  if [[ "$option" == *=* ]]; then print -r -- "${option#*=}"; else print -r -- "$fallback"; fi
}

function august-start () {
  local -a arguments=("$@")
  local -a backend_option frontend_option tools_option ai_completions_option external_api_option fullstack_option
  zparseopts -D -E -- \
    -backend::=backend_option \
    -frontend::=frontend_option \
    -tools::=tools_option \
    -ai-completions::=ai_completions_option \
    -external-api::=external_api_option \
    -fullstack::=fullstack_option || return 1

  local -A branches
  [ -n "$backend_option" ]        && branches[b]=$(_august-branch "$backend_option[-1]" master)
  [ -n "$frontend_option" ]       && branches[f]=$(_august-branch "$frontend_option[-1]" master)
  [ -n "$tools_option" ]          && branches[t]=$(_august-branch "$tools_option[-1]" main)
  [ -n "$ai_completions_option" ] && branches[a]=$(_august-branch "$ai_completions_option[-1]" main)
  [ -n "$external_api_option" ]   && branches[e]=$(_august-branch "$external_api_option[-1]" master)

  if [ -n "$fullstack_option" ]; then
    local fullstack_branch=$(_august-branch "$fullstack_option[-1]" master)
    : ${branches[b]:=$fullstack_branch}
    : ${branches[f]:=$fullstack_branch}
    : ${branches[e]:=$fullstack_branch}
  fi

  local -a selected=(${(ko)branches})
  local letters="${(j::)selected}"
  if [ -z "$letters" ]; then
    echo "usage: august-start [--backend[=branch]] [--frontend[=branch]] [--tools[=branch]] [--ai-completions[=branch]] [--external-api[=branch]] [--fullstack[=branch]]"
    return 1
  fi

  if [ -n "${branches[b]}" ] || [ -n "${branches[e]}" ]; then
    nc -z localhost 5432 2>/dev/null || {
      echo "no postgres on 5432 — podman machine start && docker start db"
      return 1
    }
  fi

  local -A directories=(
    a "$AUGUST_AI_COMPLETIONS_PATH"
    b "$AUGUST_BACKEND_PATH"
    e "$AUGUST_BACKEND_PATH"
    f "$AUGUST_FRONTEND_PATH"
    t "$AUGUST_TOOLS_PATH"
  )

  local terminal_letter argument
  for argument in $arguments; do
    case "${argument%%=*}" in
      --backend|--fullstack) terminal_letter=b ;;
      --frontend)            terminal_letter=f ;;
      --tools)               terminal_letter=t ;;
      --ai-completions)      terminal_letter=a ;;
      --external-api)        terminal_letter=e ;;
      *) continue ;;
    esac
    break
  done

  local session=fullstack
  local window="$session":dev-servers

  if tmux has-session -t "$session" 2>/dev/null; then
    _august-attach "$session"
    return
  fi

  tmux new-session -d -s "$session" -n dev-servers -c "${directories[$terminal_letter]}"
  tmux set-option -t "$session" set-titles-string "dev servers ($letters)"
  tmux setw -t "$window" pane-border-status top
  tmux setw -t "$window" main-pane-width 55%
  tmux select-pane -t "$window" -T terminal
  tmux send-keys -t "$window" "wk ${branches[$terminal_letter]}" C-m

  local letter title start_command
  local split=-h
  for letter in $selected; do
    case "$letter" in
      a) title="ai-completions :8080"     start_command="pnpm install && pnpm dev" ;;
      b) title="loquat :9000"             start_command="cd loquat && sbt run" ;;
      e) title="api-integrations :9003"   start_command="cd loquat && sbt 'apiIntegrations/run'" ;;
      f) title="frontend :3000"           start_command="yarn install && yarn start" ;;
      t) title="experimental-tools :5173" start_command="yarn install && yarn dev" ;;
    esac
    tmux split-window "$split" -t "$window" -c "${directories[$letter]}"
    tmux select-pane -t "$window" -T "$title"
    tmux send-keys -t "$window" "wk ${branches[$letter]} && $start_command" C-m
    split=-v
  done

  tmux select-layout -t "$window" main-vertical
  tmux select-pane -t "$window".1
  _august-attach "$session"
}

function august-stop () {
  tmux kill-session -t fullstack 2>/dev/null
  local port
  for port in 9000 9003 3000 5173 8080; do
    kill $(lsof -ti tcp:$port -sTCP:LISTEN) 2>/dev/null
  done
}

function demo-data-token () {
  local -a staging
  zparseopts -D -E -- -staging=staging
  local user="${1:-$AUGUST_DEFAULT_USER}"
  local cognito
  [ -n "$staging" ] && cognito=-c

  export DEMO_DATA_TOKEN=$(
    cd "$AUGUST_BACKEND_PATH/demo-data" && ./bin/python test_token.py $cognito -e "$user" | tail -1
  )
  echo "$DEMO_DATA_TOKEN"
}

function wkfs () {
  case "$1" in
    ls) shift; _wkfs-ls "$@"; return ;;
    rm) shift; _wkfs-rm "$@"; return ;;
    *)         _wkfs "$@";    return ;;
  esac
}

function _wkfs () {
  local flags=("${@[1,-2]}")
  local branch="${@[-1]}"

  if [ -z "$flags" ] && [ "$branch" = master ]; then
    cd "$AUGUST_FULLSTACK_PATH"
    return
  fi

  local backend_source="$AUGUST_BACKEND_PATH" frontend_source="$AUGUST_FRONTEND_PATH"
  [ "$flags" = -h ] && { backend_source="$PWD/backend"; frontend_source="$PWD/frontend" }

  local backend_worktree frontend_worktree
  backend_worktree=$(cd "$backend_source" && wk $flags "$branch")   || return 1
  frontend_worktree=$(cd "$frontend_source" && wk $flags "$branch") || return 1

  local worktree_directory="$AUGUST_FULLSTACK_PATH/.august-fullstack-worktrees/$branch"
  mkdir -p "$worktree_directory"
  ln -sfn "$backend_worktree"  "$worktree_directory/backend"
  ln -sfn "$frontend_worktree" "$worktree_directory/frontend"
  cd "$worktree_directory"
}

function _wkfs-ls () {
  local root="$AUGUST_FULLSTACK_PATH/.august-fullstack-worktrees"
  for backend_link in "$root"/**/backend(N@); do
    local branch_dir="${backend_link%/backend}"
    echo "${branch_dir#$root/}"
  done
}

function _wkfs-rm () {
  local branch="$1"
  local worktree_directory="$AUGUST_FULLSTACK_PATH/.august-fullstack-worktrees/$branch"
  [[ "$PWD" == "$worktree_directory"* ]] && cd "$AUGUST_FULLSTACK_PATH"

  (cd "$AUGUST_BACKEND_PATH"  && wk rm "$branch")
  (cd "$AUGUST_FRONTEND_PATH" && wk rm "$branch")

  rm -rf "$worktree_directory"
}

# Completions
function _wkfs_completions () {
  local subcommands=(
    'ls:branches with a fullstack worktree'
    'rm:remove both worktrees and delete the branch'
    '-b:new branch off the default branch'
    '-h:new branch off HEAD'
  )
  case "$CURRENT" in
    2)
      local refs=(${(f)"$(git -C "$AUGUST_BACKEND_PATH" for-each-ref --format='%(refname)' refs/heads refs/remotes/origin 2>/dev/null)"})
      local branches=(${(u)${${refs#refs/heads/}#refs/remotes/origin/}:#HEAD})
      _describe 'command' subcommands
      _describe 'branch' branches
      ;;
    3)
      [ "$words[2]" = rm ] || return
      local worktrees=(${(f)"$(_wkfs-ls)"})
      _describe 'worktree' worktrees
      ;;
  esac
}
compdef _wkfs_completions wkfs
