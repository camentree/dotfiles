export PATH="$HOME/.npm-global/bin:$PATH"
export DOTFILES_PATH="${${:-$HOME/.zshrc}:A:h:h}"

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt extended_history share_history hist_expire_dups_first hist_ignore_dups hist_ignore_space hist_verify

# Completions
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
compdef _wk_completions wk

# Starship prompt
eval "$(starship init zsh)"

# Aliases
alias cov-clean="rm .coverage.*"
alias git-open="open \`git config --get remote.origin.url\`"
alias vim="nvim"
alias vd="deactivate"
alias g="git"
alias gaa="git add --all"
alias gcm="git commit -m"
alias gco="git checkout"
alias dotfiles="cd $DOTFILES_PATH && tabname dotfiles && vim"

# Key bindings
bindkey "^X\\x7f" backward-kill-line
bindkey "^X^_" redo
bindkey "^[[1;5D" backward-word
bindkey "^[[1;5C" forward-word

# Up/down arrows search history by typed prefix
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey "^[[A" up-line-or-beginning-search
bindkey "^[OA" up-line-or-beginning-search
bindkey "^[[B" down-line-or-beginning-search
bindkey "^[OB" down-line-or-beginning-search

# Remove . from word characters so Option+Delete stops at periods
WORDCHARS=${WORDCHARS//.}

# Functions
function loadenv () { set -o allexport; source "${1:-.}/.env"; set +o allexport ; }
function ls-ports () { lsof -PiTCP -sTCP:LISTEN ; }
function nvim () { OUTER_TTY=${OUTER_TTY:-$TTY} command nvim "$@" ; }
function va () { source .venv/bin/activate ; }
function vn () { uv venv --python "${1:-3.13}" ".venv" ; echo "Created .venv" ; va ; }
function vdd () { deactivate 2>/dev/null ; rm -rf .venv ; echo "Removed .venv" ; }
function nix-rebuild () {
  sudo $(which darwin-rebuild) switch --flake "$DOTFILES_PATH#$NIX_MACHINE" "$@"
}
function airpods-max () { blueutil --connect 08:FF:44:49:DD:C8 --wait-connect 08:FF:44:49:DD:C8 10 ; }
function notes () {
  local notebook="$NOTEBOOK_PATH"
  [ -n "$notebook" ] || { print -u2 "NOTEBOOK_PATH unset"; return 1 }

  local heading="## $(date +%Y-%m-%d)"
  mkdir -p "${notebook:h}"
  [ -f "$notebook" ] || : > "$notebook"

  if ! grep -qxF "$heading" "$notebook"; then
    local prepended="${notebook}.prepending"
    printf '%s\n\n' "$heading" | cat - "$notebook" > "$prepended" \
      && mv "$prepended" "$notebook"
  fi

  cd "${notebook:h}" && tabname notes && nvim "$notebook"
}
function todo () {
  local todo_file="$TODO_PATH"
  [ -n "$todo_file" ] || { print -u2 "TODO_PATH unset"; return 1 }

  cd "${todo_file:h}" && tabname todo && nvim "$todo_file"
}
## Functions -- Claude Tab Status
[[ -z "$OUTER_TTY" && -n "$TTY" ]] && rm -f "$HOME/.claude/tab-names/${TTY:t}"

function claude() {
  CLAUDE_CODE_DISABLE_TERMINAL_TITLE=1 OUTER_TTY=${OUTER_TTY:-$TTY} command claude "$@"
}

function tabname () {
  local tab_key="${${OUTER_TTY:-$TTY}:t}"
  mkdir -p "$HOME/.claude/tab-names"
  if [ -n "$*" ]; then
    print -r -- "$*" > "$HOME/.claude/tab-names/$tab_key"
  else
    rm -f "$HOME/.claude/tab-names/$tab_key"
  fi
  printf '\033]2;%s\033\\' "${*:-${PWD:t}}" > "${OUTER_TTY:-$TTY}"
}

## Functions -- Git Worktrees
function wk () {
  case "$1" in
    ls)    shift; _wk-ls "$@" ;;
    rm)    shift; _wk-rm "$@" ;;
    clean) shift; _wk-clean "$@" ;;
    *)            _wk "$@" ;;
  esac
}

function claude-move-session () {
  local session_id="$1"
  local target_path="${2:-$PWD}"
  [ -z "$session_id" ] && { echo "Usage: claude-move-session <session-id> [target-path]"; return 1; }
  local source_jsonl=$(find "$HOME/.claude/projects" -maxdepth 2 -name "${session_id}.jsonl" -print -quit 2>/dev/null)
  [ -z "$source_jsonl" ] && { echo "Session not found: $session_id"; return 1; }
  local source_dir="${source_jsonl:h}"
  [[ "$target_path" != /* ]] && target_path="$PWD/$target_path"
  target_path="${target_path%/}"
  local encoded="${target_path//[\/.]/-}"
  local target_dir="$HOME/.claude/projects/$encoded"
  mkdir -p "$target_dir"
  mv "$source_jsonl" "$target_dir/"
  [ -d "$source_dir/${session_id}" ] && mv "$source_dir/${session_id}" "$target_dir/"
  echo "Moved $session_id -> $encoded"
}

# Function Helpers
function _confirm () {
  local reply_confirm
  read "reply_confirm?Proceed? [y/N] " || return 1
  [[ "$reply_confirm" == [yY]* ]]
}
function _wk-repo-root () { git rev-parse --path-format=absolute --git-common-dir 2>/dev/null | sed 's#/\.git$##'; }
function _wk-default-branch () { git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##'; }
function _wk-path () { print -r -- "${1:h}/.${1:t}-worktrees/$2" ; }
function _wk () {
  local mode=switch
  case "$1" in
    -b) mode=new-from-default; shift ;;
    -h) mode=new-from-here;   shift ;;
  esac
  local branch="$1"
  local repo_root=$(_wk-repo-root)
  local worktree_path=$(_wk-path "$repo_root" "$branch")
  local subdir=$(git rev-parse --show-prefix)

  case "$mode" in
    switch)
      local existing=$(git worktree list --porcelain | awk -v b="refs/heads/$branch" '
        $1=="worktree" { p=$2 }
        $1=="branch" && $2==b { print p; exit }')
      if [ -n "$existing" ]; then
        cd "$existing/$subdir" 2>/dev/null || cd "$existing"
        print -r -- "$PWD"
        return 0
      fi
      if [ "$branch" = "$(_wk-default-branch)" ]; then
        git -C "$repo_root" checkout "$branch" >&2 || return 1
        cd "$repo_root/$subdir" 2>/dev/null || cd "$repo_root"
        print -r -- "$PWD"
        return 0
      fi
      git worktree add "$worktree_path" "$branch" >&2 || return 1
      ;;
    new-from-default)
      local default=$(_wk-default-branch)
      [ -z "$default" ] && { echo "origin/HEAD not set — use 'wk -h $branch' instead"; return 1; }
      git fetch origin "$default" --quiet 2>/dev/null
      git worktree add -b "$branch" --no-track "$worktree_path" "origin/$default" >&2 || return 1
      ;;
    new-from-here) git worktree add -b "$branch" "$worktree_path" >&2 || return 1 ;;
  esac

  _wk-share-files "$repo_root" "$worktree_path"

  cd "$worktree_path/$subdir" 2>/dev/null || cd "$worktree_path"
  print -r -- "$PWD"
}
function _wk-share-files () {
  local repo_root="$1" worktree_path="$2"
  local -A share_sources=()
  local share_file share_pattern share_source share_target
  for share_file in "$repo_root/.worktreeinclude" "$repo_root/.worktreeinclude.local"; do
    [ -f "$share_file" ] || continue
    while IFS= read -r share_pattern; do
      [[ -z "$share_pattern" || "$share_pattern" == \#* ]] && continue
      if [[ "$share_pattern" == !* ]]; then
        for share_source in "$repo_root"/${~share_pattern#!}(N); do
          unset "share_sources[$share_source]"
        done
      else
        for share_source in "$repo_root"/${~share_pattern}(N); do
          share_sources[$share_source]=1
        done
      fi
    done < "$share_file"
  done
  for share_source in "${(k)share_sources[@]}"; do
    share_target="$worktree_path/${share_source#$repo_root/}"
    mkdir -p "${share_target:h}"
    ln -sf "$share_source" "$share_target"
  done
}
function _wk-ls () {
  git worktree list --porcelain | awk '/^branch / { sub(/^refs\/heads\//, "", $2); print $2 }'
}
function _wk-rm () {
  local branch="${1:-$(git rev-parse --abbrev-ref HEAD 2>/dev/null)}"
  [ -z "$branch" ] && { echo "Usage: wk rm [branch]"; return 1; }
  local repo_root=$(_wk-repo-root)
  [ -z "$repo_root" ] && { echo "Not in a git repo"; return 1; }
  local worktree_path=$(_wk-path "$repo_root" "$branch")
  [[ "$PWD" == "$worktree_path"* ]] && cd "$repo_root"
  local encoded_worktree="${worktree_path//[\/.]/-}"
  for proj_dir in "$HOME/.claude/projects/$encoded_worktree"(N) "$HOME/.claude/projects/${encoded_worktree}-"*(N); do
    for jsonl in "$proj_dir"/*.jsonl(N); do
      claude-move-session "${jsonl:t:r}" "$repo_root"
    done
    rmdir "$proj_dir" 2>/dev/null
  done
  rm -rf "$worktree_path"
  git worktree prune
  if git branch -q -D "$branch"; then
    echo "Removed: $branch"
  else
    echo "Removed worktree; kept branch: $branch"
  fi
}
function _wk-clean () {
  local repo_root=$(_wk-repo-root)
  local branches=($(git worktree list --porcelain | awk -v root=$repo_root '
    $1=="worktree" { path=$2 }
    $1=="branch" && path!=root { sub(/^refs\/heads\//, "", $2); print $2 }'))
  [ ${#branches} -eq 0 ] && { echo "No worktrees to remove"; return 0; }
  print -l "Will remove ${#branches} worktree(s) and force-delete their branches:" ${branches/#/  }
  _confirm || return 1
  local branch
  for branch in $branches; do _wk-rm "$branch"; done
}
function _wk_completions () {
  [ -n "$(_wk-repo-root)" ] || return
  local subcommands=(
    'ls:branches with a worktree'
    'rm:remove a worktree and delete its branch'
    'clean:remove every worktree in this repo'
    '-b:new branch off the default branch'
    '-h:new branch off HEAD'
  )
  case "$CURRENT" in
    2)
      local refs=(${(f)"$(git for-each-ref --format='%(refname)' refs/heads refs/remotes/origin 2>/dev/null)"})
      local branches=(${(u)${${refs#refs/heads/}#refs/remotes/origin/}:#HEAD})
      _describe 'command' subcommands
      _describe 'branch' branches
      ;;
    3)
      [ "$words[2]" = rm ] || return
      local worktrees=(${(f)"$(_wk-ls)"})
      _describe 'worktree' worktrees
      ;;
  esac
}


[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

