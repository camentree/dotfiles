export NOTEBOOK_PATH="$HOME/Documents/notes/Notebook.md"
export TODO_PATH="$HOME/Documents/notes/ToDo.md"
export AUGUST_FULLSTACK_PATH="$HOME/Projects/august-fullstack"
export AUGUST_BACKEND_PATH="$AUGUST_FULLSTACK_PATH/august-backend"
export AUGUST_FRONTEND_PATH="$AUGUST_FULLSTACK_PATH/august-frontend"
export AUGUST_TOOLS_PATH="$HOME/Projects/Experimental-Tools"
[[ -n "$AUGUST_DEFAULT_USER" ]] || print -u2 "AUGUST_DEFAULT_USER unset — set it in ~/.zshenv.local"

alias fullstack="cd $AUGUST_FULLSTACK_PATH"
alias backend="cd $AUGUST_BACKEND_PATH/loquat"
alias frontend="cd $AUGUST_FRONTEND_PATH"
alias notes="cd $HOME/Documents/notes && tabname notes && nvim ToDo.md"
alias dotfiles="cd $HOME/Projects/dotfiles"

function _august-attach () {
  if [ -n "$TMUX" ]; then tmux switch-client -t "$1"
  else tmux attach -t "$1"; fi
}

function august-start () {
  local -a backend_option frontend_option tools_option
  zparseopts -D -E -- -backend:=backend_option -frontend:=frontend_option -tools:=tools_option
  local backend_branch="${backend_option[-1]:-master}"
  local frontend_branch="${frontend_option[-1]:-master}"
  local tools_branch="${tools_option[-1]:-main}"
  local session=fullstack
  local window="$session":full-stack

  nc -z localhost 5432 2>/dev/null || {
    echo "no postgres on 5432 — podman machine start && docker start db"
    return 1
  }

  if tmux has-session -t "$session" 2>/dev/null; then
    _august-attach "$session"
    return
  fi

  tmux new-session -d -s "$session" -n full-stack -c "$AUGUST_FULLSTACK_PATH"
  tmux setw -t "$window" pane-border-status top
  tmux setw -t "$window" main-pane-width 55%
  tmux select-pane -t "$window" -T terminal

  tmux split-window -h -t "$window" -c "$AUGUST_BACKEND_PATH"
  tmux select-pane -t "$window".2 -T "loquat :9000"
  tmux send-keys -t "$window".2 "wk $backend_branch && cd loquat && sbt run" C-m

  tmux split-window -v -t "$window".2 -c "$AUGUST_BACKEND_PATH"
  tmux select-pane -t "$window".3 -T "api-integrations :9003"
  tmux send-keys -t "$window".3 "wk $backend_branch && cd loquat && sbt 'apiIntegrations/run'" C-m

  tmux split-window -v -t "$window".3 -c "$AUGUST_FRONTEND_PATH"
  tmux select-pane -t "$window".4 -T "frontend :3000"
  tmux send-keys -t "$window".4 "wk $frontend_branch && yarn install && yarn start" C-m

  tmux split-window -v -t "$window".4 -c "$AUGUST_TOOLS_PATH"
  tmux select-pane -t "$window".5 -T "experimental-tools :5173"
  tmux send-keys -t "$window".5 "wk $tools_branch && yarn install && yarn dev" C-m

  tmux select-layout -t "$window" main-vertical
  tmux select-pane -t "$window".1
  _august-attach "$session"
}

function august-stop () {
  tmux kill-session -t fullstack 2>/dev/null
  local port
  for port in 9000 9003 3000 5173; do
    kill $(lsof -ti tcp:$port -sTCP:LISTEN) 2>/dev/null
  done
}

function demo-data-token () {
  local -a staging
  zparseopts -D -E -- -staging=staging
  local user="${1:-$AUGUST_DEFAULT_USER}"
  local cognito
  [ -n "$staging" ] && cognito=-c

  export DEMO_DATA_TOKEN=$(
    cd "$AUGUST_BACKEND_PATH/demo-data" && ./bin/python test_token.py $cognito -e "$user" | tail -1
  )
  echo "$DEMO_DATA_TOKEN"
}

function wkfs () {
  case "$1" in
    ls) shift; _wkfs-ls "$@"; return ;;
    rm) shift; _wkfs-rm "$@"; return ;;
    *)         _wkfs "$@";    return ;;
  esac
}

function _wkfs () {
  local flags=("${@[1,-2]}")
  local branch="${@[-1]}"

  if [ -z "$flags" ] && [ "$branch" = master ]; then
    cd "$AUGUST_FULLSTACK_PATH"
    return
  fi

  local backend_source="$AUGUST_BACKEND_PATH" frontend_source="$AUGUST_FRONTEND_PATH"
  [ "$flags" = -h ] && { backend_source="$PWD/backend"; frontend_source="$PWD/frontend" }

  local backend_worktree frontend_worktree
  backend_worktree=$(cd "$backend_source" && wk $flags "$branch")   || return 1
  frontend_worktree=$(cd "$frontend_source" && wk $flags "$branch") || return 1

  local worktree_directory="$AUGUST_FULLSTACK_PATH/.august-fullstack-worktrees/$branch"
  mkdir -p "$worktree_directory"
  ln -sfn "$backend_worktree"  "$worktree_directory/backend"
  ln -sfn "$frontend_worktree" "$worktree_directory/frontend"
  cd "$worktree_directory"
}

function _wkfs-ls () {
  local root="$AUGUST_FULLSTACK_PATH/.august-fullstack-worktrees"
  for backend_link in "$root"/**/backend(N@); do
    local branch_dir="${backend_link%/backend}"
    echo "${branch_dir#$root/}"
  done
}

function _wkfs-rm () {
  local branch="$1"
  local worktree_directory="$AUGUST_FULLSTACK_PATH/.august-fullstack-worktrees/$branch"
  [[ "$PWD" == "$worktree_directory"* ]] && cd "$AUGUST_FULLSTACK_PATH"

  (cd "$AUGUST_BACKEND_PATH"  && wk rm "$branch")
  (cd "$AUGUST_FRONTEND_PATH" && wk rm "$branch")

  rm -rf "$worktree_directory"
}
